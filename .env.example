# ── Chain ─────────────────────────────────────────────────────────────────────
# Base Sepolia — lending contract, MockUSDC, gas funding
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=0x...          # deployed AgentFiLending address
USDC_ADDRESS=0x...              # MockUSDC on Base Sepolia

# Ethereum Sepolia (L1) — ENS resolution only
# ENS names are registered on Ethereum Sepolia, NOT on Base Sepolia
L1_SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Sepolia ENS Public Resolver (official, from docs.ens.domains — updated 2024-01-27)
ENS_RESOLVER_ADDRESS=0x8FADE66B79cC9f707aB26799354482EB93a5B7dD

# ── Platform signer (co-signer key — use KMS in prod) ─────────────────────────
PLATFORM_PRIVATE_KEY=0x...      # NEVER commit this — use AWS KMS in production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/agentfi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# ── External services ─────────────────────────────────────────────────────────
BITGO_API_KEY=...
BITGO_WALLET_ID=...
HEYELSA_API_KEY=...
FILEVERSE_API_KEY=...
# ENS_DEPLOYER_KEY is no longer needed — users bring their own ENS names

# ── Agent process env (set per spawned agent) ─────────────────────────────────
# AGENT_ID=uuid
# AGENT_ROLE=borrower|lender
# AGENT_PRIVATE_KEY=0x...      # agent's half of 2-of-2
# AGENT_WALLET=0x...           # multisig address
# AGENT_JWT=...
# FILEVERSE_DOC_ID=...
